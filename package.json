{
  "name": "grocery-price-agent-poc",
  "version": "1.0.0",
  "description": "Universal Multi-Agent Price Comparison and Basket Optimizer with MCP Protocol and OpenAI LLM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "dev": "node --watch -r ts-node/register src/server.ts",
    "watch": "node --watch -r ts-node/register src/server.ts",
    "cli": "ts-node src/cli.ts",
    "mcp": "ts-node src/mcp/server.ts",
    "session:capture": "node scripts/capture-session.js",
    "session:zepto": "node scripts/capture-session.js zepto",
    "session:instamart": "node scripts/capture-session.js instamart",
    "session:blinkit": "node scripts/capture-session.js blinkit",
    "session:jiomart": "node scripts/capture-session.js jiomart",
    "session:flipkart": "node scripts/capture-session.js flipkart",
    "session:amazon": "node scripts/capture-session.js amazon",
    "session:bigbasket": "node scripts/capture-session.js bigbasket"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "axios": "^1.7.9",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.83.0",
    "puppeteer": "^25.5.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
