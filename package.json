{
  "name": "grocery-price-agent-poc",
  "version": "1.0.0",
  "description": "Grocery basket optimizer: compares quick-commerce prices (sample price database) and finds the cheapest store or split, with Groq LLM parsing",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "cli": "ts-node src/cli.ts",
    "mcp": "ts-node src/mcp/mcp-server.ts",
    "db:seed": "ts-node src/modules/database/seed/run-seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "nest-winston": "^1.10.2",
    "openai": "^4.83.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
