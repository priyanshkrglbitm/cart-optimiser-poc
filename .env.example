# Copy to .env and fill in. Never commit .env.
PORT=3000

# Seconds × 1000 to wait for each store before marking it as failed (default 45000)
# STORE_TIMEOUT_MS=45000

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Any OpenAI-compatible provider works by changing these two.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b   (run GET /openai/v1/models to see what your key can use)
