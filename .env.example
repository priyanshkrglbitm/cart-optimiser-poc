# Copy to .env and fill in. Never commit .env.
PORT=3079

# Log detail: error | warn | info (default) | debug | verbose. Logs also go to logs/app-*.log and logs/error-*.log
# LOG_LEVEL=info

# SQLite price database file (created and filled with sample data on first start)
# DB_PATH=data/basket.db

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Any OpenAI-compatible provider works by changing these two.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b   (run GET /openai/v1/models to see what your key can use)
